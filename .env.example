# Render web service and worker
DATABASE_URL=
# Restricted login with membership in lb_dashboard for the web service
DASHBOARD_DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Set on both servers only. Keep it out of browser builds.
SUPABASE_SERVER_KEY=
IMPORT_QUEUE=pgmq
IMPORT_BUCKET=link-brasil-importacoes
# Use require for Supabase connections, or verify-full with your CA.
PGSSLMODE=require

