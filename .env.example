# Copie este arquivo para .env e substitua somente os valores de exemplo.
# Nunca envie o arquivo .env ao GitHub, e-mail ou chat.

# Identificacao e limites da implantacao Docker
COMPOSE_PROJECT_NAME=central-vendas-link-brasil
WEB_BIND_ADDRESS=127.0.0.1
APP_PORT=3000
WEB_CPUS=0.50
WEB_MEMORY_LIMIT=384m
WORKER_CPUS=0.50
WORKER_MEMORY_LIMIT=512m
TZ=America/Sao_Paulo

# URL HTTPS publica exata, sem barra no final.
APP_ORIGIN=https://vendas.exemplo.com.br

# Supabase Auth e Storage
SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUBSTITUA
SUPABASE_SERVER_KEY=sb_secret_SUBSTITUA

# Importador: Session Pooler com usuario autorizado a administrar comercial e pgmq.
# Codifique caracteres especiais da senha na URL (percent-encoding).
DATABASE_URL=postgresql://USUARIO_IMPORTADOR:SENHA_CODIFICADA@HOST_POOLER:5432/postgres?sslmode=require

# Painel: Session Pooler com login restrito, membro da funcao lb_dashboard.
DASHBOARD_DATABASE_URL=postgresql://USUARIO_PAINEL:SENHA_CODIFICADA@HOST_POOLER:5432/postgres?sslmode=require

# Fila e armazenamento privados criados por db/supabase.sql
IMPORT_QUEUE=pgmq
IMPORT_BUCKET=link-brasil-importacoes
PGSSLMODE=require

